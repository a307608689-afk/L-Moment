<?xml version="1.0" encoding="utf-8"?>
<!-- 三级页：导出与元数据（徕卡徽章 / 保存位置 / 导出时间 / 设备标识） -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#000000"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/rowLeicaBadge"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="20dp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/bg_settings_row"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingTop="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="徕卡徽章"
                android:textColor="#E8E8EA"
                android:textSize="15sp" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/txtLeicaBadgeValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="开"
                android:textColor="#8E8E93"
                android:textSize="15sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="›"
                android:textColor="#5A5A5E"
                android:textSize="15sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/txtLeicaBadgeHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:paddingStart="32dp"
            android:paddingEnd="32dp"
            android:text="开 = 导出写入徕卡识别元数据，相册显示「徕卡」徽章\n关 = 导出无徽章，并清除源图自带的徽章元数据\n机型、拍摄参数、GPS 等 EXIF 不受开关影响"
            android:textColor="#5A5A5E"
            android:textSize="12sp" />

        <LinearLayout
            android:id="@+id/rowSavePath"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="20dp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/bg_settings_row"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingTop="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="保存位置"
                android:textColor="#E8E8EA"
                android:textSize="15sp" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/txtSavePathValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxWidth="200dp"
                android:maxLines="1"
                android:text="Pictures/LeicaMoments"
                android:textColor="#8E8E93"
                android:textSize="15sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="›"
                android:textColor="#5A5A5E"
                android:textSize="15sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/txtSavePathHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:paddingStart="32dp"
            android:paddingEnd="32dp"
            android:text="导出照片在相册中的落点，子目录不存在会自动创建\n只影响之后导出的文件；已导出的不受影响"
            android:textColor="#5A5A5E"
            android:textSize="12sp" />

        <LinearLayout
            android:id="@+id/rowExportTime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="20dp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/bg_settings_row"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingTop="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="导出时间"
                android:textColor="#E8E8EA"
                android:textSize="15sp" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/txtExportTimeValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="按图片原本时间"
                android:textColor="#8E8E93"
                android:textSize="15sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="›"
                android:textColor="#5A5A5E"
                android:textSize="15sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/txtExportTimeHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:paddingStart="32dp"
            android:paddingEnd="32dp"
            android:text="原本时间 = 相册按源图拍摄时间显示与排序\n当下时间 = 导出的照片在相册里如刚拍摄\n文件属性时间始终为导出时刻（系统机制），GPS/机型/参数不受影响"
            android:textColor="#5A5A5E"
            android:textSize="12sp" />

        <LinearLayout
            android:id="@+id/rowDeviceInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="20dp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/bg_settings_row"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingTop="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="设备标识"
                android:textColor="#E8E8EA"
                android:textSize="15sp" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/txtDeviceInfoValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="跟随原图"
                android:textColor="#8E8E93"
                android:textSize="15sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="›"
                android:textColor="#5A5A5E"
                android:textSize="15sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/txtDeviceInfoHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:paddingStart="32dp"
            android:paddingEnd="32dp"
            android:text="导出图片的机型取自原图 EXIF；原图无 EXIF 时使用本机型号\n只影响设备标识，拍摄参数与 GPS 不受影响"
            android:textColor="#5A5A5E"
            android:textSize="12sp" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="24dp" />

    </LinearLayout>
</ScrollView>
