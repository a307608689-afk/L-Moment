<?xml version="1.0" encoding="utf-8"?>
<!--
  设置（二级）：顶栏 + 页内页面栈。
  首屏只放 5 个分类入口（settings_hub），明细在各三级页（settings_page_*）；
  同一 Activity 内切换，返回键与 ← 钮走自管栈（三级 → 首屏 → 主界面）。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:orientation="vertical">

    <!-- 顶栏：与主界面同几何（56dp / 17sp bold 居中标题），标题随页面切换 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="16dp">

        <TextView
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_title_ripple"
            android:contentDescription="返回"
            android:gravity="center"
            android:text="←"
            android:textColor="#E8E8EA"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/txtTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="设置"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:textStyle="bold" />

        <!-- 与返回钮等宽，保证标题真正居中 -->
        <Space
            android:layout_width="48dp"
            android:layout_height="1dp" />
    </LinearLayout>

    <!-- 页面栈：同一时刻只有一页可见（首屏 + 5 个三级页） -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <include
            android:id="@+id/pageHub"
            layout="@layout/settings_hub"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <include
            android:id="@+id/pageDisplay"
            layout="@layout/settings_page_display"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <include
            android:id="@+id/pageQuality"
            layout="@layout/settings_page_quality"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <include
            android:id="@+id/pageExport"
            layout="@layout/settings_page_export"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <include
            android:id="@+id/pageAi"
            layout="@layout/settings_page_ai"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <include
            android:id="@+id/pageColors"
            layout="@layout/settings_page_colors"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

    </FrameLayout>

</LinearLayout>
