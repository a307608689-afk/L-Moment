<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#000000">

    <!-- 顶部工具栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <TextView
            android:id="@+id/btnImport"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center"
            android:paddingEnd="16dp"
            android:text="导入"
            android:textColor="#E8E8EA"
            android:textSize="15sp" />

        <!-- 分类入口：标题 + 小三角 + 圆角波纹（48dp 触达高度，点按弹出分类列表） -->
        <LinearLayout
            android:id="@+id/btnCategory"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_title_ripple"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <TextView
                android:id="@+id/txtTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="L-Moment"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/imgTitleArrow"
                android:layout_width="10dp"
                android:layout_height="7dp"
                android:layout_marginStart="6dp"
                android:contentDescription="展开分类"
                android:src="@drawable/ic_arrow_down" />
        </LinearLayout>

        <TextView
            android:id="@+id/btnExport"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center"
            android:paddingStart="16dp"
            android:text="导出"
            android:textColor="#E8E8EA"
            android:textSize="15sp" />
    </LinearLayout>

    <!-- 预览区 -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#000000">

        <com.leicamoments.app.ZoomableImageView
            android:id="@+id/imgPreview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="预览" />

        <TextView
            android:id="@+id/txtEmpty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="导入一张图片，体验内置色彩风格"
            android:textColor="#5A5A5E"
            android:textSize="14sp" />

        <ProgressBar
            android:id="@+id/progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />

        <!-- 大图（≥1 亿像素）导出进度浮层：环形进度 + 百分比，替代普通转圈（仅大图导出分支显示） -->
        <LinearLayout
            android:id="@+id/bigExportOverlay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/bg_big_export_overlay"
            android:elevation="12dp"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="36dp"
            android:paddingTop="28dp"
            android:paddingEnd="36dp"
            android:paddingBottom="28dp"
            android:visibility="gone">

            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:id="@+id/bigExportRing"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:indeterminate="true"
                app:indicatorColor="#F2F2F2"
                app:indicatorSize="54dp"
                app:trackColor="#33FFFFFF"
                app:trackCornerRadius="3dp"
                app:trackThickness="5dp" />

            <TextView
                android:id="@+id/bigExportPercent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="准备中"
                android:textColor="#F2F2F2"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/bigExportHint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="全像素导出中 · 可退回桌面等待"
                android:textColor="#99F2F2F2"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- 画质工具胶囊行（顶栏下方悬浮）：左侧超分双钮，右侧「设置」恒可见 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_marginStart="16dp"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnSuperRes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill"
                android:paddingStart="14dp"
                android:paddingTop="7dp"
                android:paddingEnd="14dp"
                android:paddingBottom="7dp"
                android:text="光学超分"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/btnSuperResFast"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_pill"
                android:paddingStart="14dp"
                android:paddingTop="7dp"
                android:paddingEnd="14dp"
                android:paddingBottom="7dp"
                android:text="快速超分"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:visibility="gone" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/btnSettings"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="16dp"
                android:background="@drawable/bg_pill"
                android:gravity="center"
                android:paddingStart="14dp"
                android:paddingTop="7dp"
                android:paddingEnd="14dp"
                android:paddingBottom="7dp"
                android:text="设置"
                android:textColor="#FFFFFF"
                android:textSize="13sp" />

        </LinearLayout>

        <!-- 首次启动一次性引导：点标题切换分类（点任意处消失） -->
        <TextView
            android:id="@+id/txtCoach"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_coach"
            android:paddingStart="14dp"
            android:paddingTop="8dp"
            android:paddingEnd="14dp"
            android:paddingBottom="8dp"
            android:text="点这里切换色彩分类"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/txtStyleHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="16dp"
            android:background="#80000000"
            android:padding="8dp"
            android:text="M9 · 彩色经典"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:visibility="gone" />

        <!-- 底部入口胶囊行：左「调节」右「完美」，悬浮在预览底部、与右下角描述同边距对齐 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|start"
            android:layout_marginStart="16dp"
            android:layout_marginBottom="16dp"
            android:orientation="horizontal">

            <!-- 调节入口（所有导入显示） -->
            <TextView
                android:id="@+id/btnAdjust"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill"
                android:elevation="8dp"
                android:paddingStart="14dp"
                android:paddingTop="7dp"
                android:paddingEnd="14dp"
                android:paddingBottom="7dp"
                android:text="调节"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:visibility="gone" />

            <!-- 完美档入口（仅 M9 / M9+ / M10-R 三档显示），紧随「调节」右侧 -->
            <TextView
                android:id="@+id/btnPerfect"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_pill"
                android:elevation="8dp"
                android:paddingStart="14dp"
                android:paddingTop="7dp"
                android:paddingEnd="14dp"
                android:paddingBottom="7dp"
                android:text="完美"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:visibility="gone" />

            <!-- HDR 输出开关（源图自带 HDR 或 RAW 时不显示），紧随「完美」右侧 -->
            <TextView
                android:id="@+id/btnHdr"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_pill"
                android:elevation="8dp"
                android:paddingStart="14dp"
                android:paddingTop="7dp"
                android:paddingEnd="14dp"
                android:paddingBottom="7dp"
                android:text="HDR"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:visibility="gone" />

        </LinearLayout>

        <!-- 调节浮层：点击「调节」向上展开五档滑杆（拖动调档，双击标签复位到 0）；再点收起 -->
        <LinearLayout
            android:id="@+id/adjPanel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|start"
            android:layout_marginStart="16dp"
            android:layout_marginBottom="56dp"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- 亮度滑杆组（排最前）：名称列统一 minWidth 44dp（=最宽名「黑色阶」），五行滑杆起止对齐；进度 0..20 ↔ 档位 -10..+10 -->
            <LinearLayout
                android:layout_width="240dp"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="10dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="44dp"
                    android:text="亮度"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp" />

                <SeekBar
                    android:id="@+id/sbBright"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:max="20"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:progress="10"
                    android:progressBackgroundTint="#59FFFFFF"
                    android:progressTint="#F2F2F2"
                    android:thumbTint="#F2F2F2" />

                <TextView
                    android:id="@+id/txtBrightVal"
                    android:layout_width="34dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:gravity="end"
                    android:text="0"
                    android:textColor="#F2F2F2"
                    android:textSize="13sp" />

            </LinearLayout>

            <!-- 曝光滑杆组：同亮度组紧凑口径 -->
            <LinearLayout
                android:layout_width="240dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_pill"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="10dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="44dp"
                    android:text="曝光"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp" />

                <SeekBar
                    android:id="@+id/sbLum"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:max="20"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:progress="10"
                    android:progressBackgroundTint="#59FFFFFF"
                    android:progressTint="#F2F2F2"
                    android:thumbTint="#F2F2F2" />

                <TextView
                    android:id="@+id/txtLumVal"
                    android:layout_width="34dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:gravity="end"
                    android:text="0"
                    android:textColor="#F2F2F2"
                    android:textSize="13sp" />

            </LinearLayout>

            <!-- 高光滑杆组（阴影前）：同亮度组紧凑口径 -->
            <LinearLayout
                android:layout_width="240dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_pill"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="10dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="44dp"
                    android:text="高光"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp" />

                <SeekBar
                    android:id="@+id/sbHigh"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:max="20"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:progress="10"
                    android:progressBackgroundTint="#59FFFFFF"
                    android:progressTint="#F2F2F2"
                    android:thumbTint="#F2F2F2" />

                <TextView
                    android:id="@+id/txtHighVal"
                    android:layout_width="34dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:gravity="end"
                    android:text="0"
                    android:textColor="#F2F2F2"
                    android:textSize="13sp" />

            </LinearLayout>

            <!-- 阴影滑杆组：同亮度组紧凑口径 -->
            <LinearLayout
                android:layout_width="240dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_pill"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="10dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="44dp"
                    android:text="阴影"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp" />

                <SeekBar
                    android:id="@+id/sbShadow"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:max="20"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:progress="10"
                    android:progressBackgroundTint="#59FFFFFF"
                    android:progressTint="#F2F2F2"
                    android:thumbTint="#F2F2F2" />

                <TextView
                    android:id="@+id/txtShadowVal"
                    android:layout_width="34dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:gravity="end"
                    android:text="0"
                    android:textColor="#F2F2F2"
                    android:textSize="13sp" />

            </LinearLayout>

            <!-- 黑色阶滑杆组：同亮度组紧凑口径 -->
            <LinearLayout
                android:layout_width="240dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_pill"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="10dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="44dp"
                    android:text="黑色阶"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp" />

                <SeekBar
                    android:id="@+id/sbBlack"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:max="20"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:progress="10"
                    android:progressBackgroundTint="#59FFFFFF"
                    android:progressTint="#F2F2F2"
                    android:thumbTint="#F2F2F2" />

                <TextView
                    android:id="@+id/txtBlackVal"
                    android:layout_width="34dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:gravity="end"
                    android:text="0"
                    android:textColor="#F2F2F2"
                    android:textSize="13sp" />

            </LinearLayout>

            <!-- 饱和度滑杆组：同黑色阶组紧凑口径 -->
            <LinearLayout
                android:layout_width="240dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_pill"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="10dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="44dp"
                    android:text="饱和度"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp" />

                <SeekBar
                    android:id="@+id/sbSat"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:max="20"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:progress="10"
                    android:progressBackgroundTint="#59FFFFFF"
                    android:progressTint="#F2F2F2"
                    android:thumbTint="#F2F2F2" />

                <TextView
                    android:id="@+id/txtSatVal"
                    android:layout_width="34dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:gravity="end"
                    android:text="0"
                    android:textColor="#F2F2F2"
                    android:textSize="13sp" />

            </LinearLayout>

            <!-- 对比度滑杆组：同黑色阶组紧凑口径 -->
            <LinearLayout
                android:layout_width="240dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_pill"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="10dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="44dp"
                    android:text="对比度"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp" />

                <SeekBar
                    android:id="@+id/sbCon"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:max="20"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:progress="10"
                    android:progressBackgroundTint="#59FFFFFF"
                    android:progressTint="#F2F2F2"
                    android:thumbTint="#F2F2F2" />

                <TextView
                    android:id="@+id/txtConVal"
                    android:layout_width="34dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:gravity="end"
                    android:text="0"
                    android:textColor="#F2F2F2"
                    android:textSize="13sp" />

            </LinearLayout>

            <!-- 柔光（第八档）：正=Orton 柔雾，负=清晰化；进度 0..20 ↔ 档位 -10..+10 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_pill"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="10dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="44dp"
                    android:text="柔光"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp" />

                <SeekBar
                    android:id="@+id/sbGlow"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:max="20"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:progress="10"
                    android:progressBackgroundTint="#59FFFFFF"
                    android:progressTint="#F2F2F2"
                    android:thumbTint="#F2F2F2" />

                <TextView
                    android:id="@+id/txtGlowVal"
                    android:layout_width="34dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:gravity="end"
                    android:text="0"
                    android:textColor="#F2F2F2"
                    android:textSize="13sp" />

            </LinearLayout>

        </LinearLayout>
    </FrameLayout>

    <!-- 底部滤镜条 -->
    <HorizontalScrollView
        android:id="@+id/filterScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#000000"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/filterContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="12dp" />
    </HorizontalScrollView>

</LinearLayout>
